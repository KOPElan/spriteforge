# spriteforge Web UI — GPU build (NVIDIA, CUDA 12.8).
#
# For Windows: Docker Desktop with the WSL2 backend, a WSL2-capable
# NVIDIA driver on the Windows host (driver 570+ for RTX 50-series),
# and the GPU reservation in docker-compose.gpu.yml. Do NOT install a
# Linux NVIDIA driver inside the container/WSL — the host driver is
# mapped through WSL2. For native Linux: install the NVIDIA Container
# Toolkit on the host instead.
#
# This image swaps the CPU onnxruntime that rembg pulls in for
# onnxruntime-gpu. The matting code already prefers
# CUDAExecutionProvider when it is available, so no code change is
# needed — if the GPU is not visible inside the container, it falls
# back to CPU (slow) rather than failing.
#
# Base: CUDA 12.8 runtime on Ubuntu 24.04 (Python 3.12 in apt).
# If your driver only supports an older CUDA, change the tag to a
# matching CUDA version AND the onnxruntime-gpu version accordingly.
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SPRITEFORGE_JOBS_DIR=/app/jobs \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml README.md LICENSE ./
COPY spriteforge ./spriteforge

# Install the app, then replace CPU onnxruntime with the GPU build.
# Never install onnxruntime and onnxruntime-gpu at the same time.
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt \
    && pip install --no-cache-dir --break-system-packages . \
    && pip uninstall -y --break-system-packages onnxruntime \
    && pip install --no-cache-dir --break-system-packages onnxruntime-gpu

RUN mkdir -p /app/jobs

EXPOSE 8000
CMD ["uvicorn", "spriteforge.web_app:app", "--host", "0.0.0.0", "--port", "8000"]
